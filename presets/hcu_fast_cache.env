# Hygon DCU / HCU accelerated training preset (Benchmark 2: Full opt + offline VAE/T5 cache + SAC24).
# Target: ~1.28 s/step on 8x BW1000 64G.
# Usage: python scripts/train.py training.speed_preset=presets/hcu_fast_cache.env ...
OPENWAM_TEXT_CACHE=1
OPENWAM_FAST_INPUT=1
OPENWAM_FUSED_ROPE=1
OPENWAM_MIXED_ATTN_CKPT=0
OPENWAM_VAE_FULLCLIP=1
OPENWAM_COMPILE_VAE=1
OPENWAM_CONTEXT_TRUNC=1
OPENWAM_COMPILE_BLOCKS=1
OPENWAM_DS_TIMER_NOSYNC=1
OPENWAM_TEXT_MISS_FAST=1
OPENWAM_DS_OVERLAP_COMM=1
OPENWAM_FAST_CAT=1
OPENWAM_GC_FREEZE=1
OPENWAM_VAE_CL=1
OPENWAM_VAE_FIRST=1
OPENWAM_NUMA_BIND=1
OPENWAM_COMMUNICATION_DATA_TYPE=bf16
OPENWAM_GRADIENT_CHECKPOINTING_LAYERS=6
OPENWAM_OPT_SAC_FFN_FULL=1
OPENWAM_OPT_CONSTANT_CACHE=1
OPENWAM_OPT_FA2_PADDING=1
OPENWAM_OPT_FA2_MASK_FUSED=1
OPENWAM_OPT_PADDING_PLAN_CPU=1
OPENWAM_OPT_LIGHTOP_NORM=1
OPENWAM_OPT_LINEAR_BIAS2D=1
OPENWAM_OPT_FUSED_ADAMW=1
OPENWAM_OPT_ZERO_OVERLAP=1
OPENWAM_OPT_ZERO_REDUCE_SCATTER=1
OPENWAM_OPT_ZERO_SCALED_PACK=1
OPENWAM_OPT_ZERO_NORM_OVERLAP=1
OPENWAM_OPT_ONLINE_ENCODE=0
OPENWAM_OPT_HOST_ASYNC=1
OPENWAM_OPT_DEFERRED_GATHER=1
OPENWAM_OPT_VAE_LATENT_CACHE=1
OPENWAM_OPT_TEXT_CACHE=1
TORCH_BLAS_PREFER_HIPBLASLT=1
HIPBLASLT_ALLOW_TF32=1
HIPBLASLT_WORKSPACE_SIZE=32768
PYTORCH_MIOPEN_SUGGEST_NHWC=1
PYTORCH_MIOPEN_SUGGEST_NDHWC=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
HSA_FORCE_FINE_GRAIN_PCIE=1
TORCHINDUCTOR_COMPILE_THREADS=1
TORCHINDUCTOR_COORDINATE_DESCENT_TUNING=1
